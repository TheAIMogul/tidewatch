{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tidewatch",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "tidewatch.micahberkley.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Donors, source records, gifts, merge candidates, the Decisions log.
  "d1_databases": [
    { "binding": "DB", "database_name": "tidewatch", "database_id": "800fba79-dec6-433f-9497-f38395ed7747", "migrations_dir": "migrations" }
  ],
  // Every uploaded export is kept as-is.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "tidewatch-files" }],
  // Embeddings for candidate matching.
  "ai": { "binding": "AI" },
  // The import pipeline: durable steps that each retry on their own.
  "workflows": [{ "name": "tidewatch-import", "binding": "IMPORT", "class_name": "ImportWorkflow" }],
  "vars": {
    "TODAY": "2026-11-08",
    "GMD_DATE": "2026-11-19",
    "ORG_NAME": "Tidepath Family Alliance",
    "STAFF_NAME": "Denise",
    "OFFICE_PHONE": "(305) 555-0100"
  }
}
